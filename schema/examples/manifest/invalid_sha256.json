        "options": [
          {
            "cost_hint": "low",
            "id": "nonbonded_12_6",
            "label": "Nonbonded 12-6 LJ ion model",
            "trade_offs": [
              "Cheapest and fully transferable; ligands may exchange freely.",
              "For divalent ions a single 12-6 parameter set cannot reproduce hydration free energy, ion-oxygen distance and coordination number at once (Li & Merz 2014), so the first shell may rearrange or collapse during sampling."
            ]
          },
          {
            "cost_hint": "low",
            "id": "nonbonded_12_6_4",
            "label": "Nonbonded 12-6-4 LJ-type ion model",
            "trade_offs": [
              "Adds an ion-induced-dipole (1/r^4) term; reproduces hydration free energy, ion-oxygen distance and coordination number for +2 ions (Li & Merz 2014).",
              "Modest overhead; needs C4 terms for each ion/atom-type pair; does not treat charge transfer explicitly."
            ]
          },
          {
            "cost_hint": "high",
            "id": "bonded_mcpb",
            "label": "Bonded model (MCPB.py-style)",
            "trade_offs": [
              "Keeps the crystallographic coordination geometry by construction.",
              "Needs QM calculations for force constants and charges (Li & Merz 2016); ligand exchange is impossible, which biases any landscape where site rearrangement matters; must be rebuilt if a variant changes a ligand."
            ]
          },
          {
            "cost_hint": "low",
            "id": "restrained",
            "label": "Nonbonded ion plus distance restraints to crystal ligands",
            "trade_offs": [
              "Cheap way to hold the site together without QM parameterization.",
              "Restraints add a bias to every free energy computed; the restraint set must be recorded and identical across WT and variants to keep comparisons fair."
            ]
          }
        ],
        "rationale": "A metal site cannot be simulated without choosing an ion model, and the choice changes the site's behaviour. The coordination shell (donor atoms within the cutoff), a geometry descriptor (RMS deviation of L-M-L angles from ideal polyhedra) and the classification are reported as evidence. Classification criteria, in order: the shell contains a non-standard polymer residue or a non-polymer ligand -> likely catalytic; an open site (few protein donors plus water) -> likely catalytic; at least the structural minimum of protein donors -> likely structural; otherwise ambiguous.",
        "recommendation_basis": "default",
        "recommended_option": "nonbonded_12_6_4",
