{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simprep:schema:variant_record",
  "x-schema-version": "0.1.0",
  "title": "simprep variant record (variant_record.json)",
  "description": "What `simprep variants` built (TASK-005): per variant the mutations with the chosen rotamer and its closest contacts, the files written, record accounting against the prepared wild type, and the work order (the wild type's plus a protonation item per mutated residue). With relaxation (TASK-006): the protocol used, a relaxed wild type per mutation site, and per relaxed system what moved, what was frozen or left out, and the clashes before and after.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "simprep",
    "knowledge_base",
    "input",
    "manifest_sha256",
    "wild_type",
    "variants",
    "relaxation_protocol",
    "relaxed_wild_types"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "simprep": {
      "$ref": "urn:simprep:schema:manifest#/$defs/simprep"
    },
    "knowledge_base": {
      "$ref": "urn:simprep:schema:manifest#/$defs/knowledge_base"
    },
    "input": {
      "$ref": "urn:simprep:schema:manifest#/$defs/input"
    },
    "manifest_sha256": {
      "$ref": "urn:simprep:schema:manifest#/$defs/sha256"
    },
    "wild_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "prep_record_sha256"
      ],
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "prep_record_sha256": {
          "$ref": "urn:simprep:schema:manifest#/$defs/sha256"
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "relaxation_protocol": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:simprep:schema:relaxation#/$defs/protocol"
        }
      ]
    },
    "relaxed_wild_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relaxed_wild_type"
      }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "directory",
        "mutations",
        "files",
        "counts",
        "work_order"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mutation"
          }
        },
        "files": {
          "$ref": "urn:simprep:schema:prep_record#/$defs/system/properties/files"
        },
        "counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:simprep:schema:prep_record#/$defs/count"
          }
        },
        "work_order": {
          "type": "array",
          "items": {
            "$ref": "urn:simprep:schema:prep_record#/$defs/work_item"
          }
        },
        "unrelaxed_files": {
          "$ref": "urn:simprep:schema:prep_record#/$defs/system/properties/files"
        },
        "relaxation": {
          "$ref": "#/$defs/relaxation"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "urn:simprep:schema:finding"
          }
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "chain",
        "seq_num",
        "ins_code",
        "from",
        "to",
        "uniprot",
        "rotamer",
        "chi_degree",
        "frequency_percent",
        "closest_contacts"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "chain": {
          "type": "string",
          "minLength": 1
        },
        "seq_num": {
          "type": "integer"
        },
        "ins_code": {
          "type": "string",
          "maxLength": 1
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,5}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,5}$"
        },
        "uniprot": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accession",
                "position"
              ],
              "properties": {
                "accession": {
                  "type": "string",
                  "minLength": 1
                },
                "position": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "rotamer": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "chi_degree": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "frequency_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "closest_contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "atom_name",
              "partner",
              "distance_angstrom",
              "overlap_angstrom"
            ],
            "properties": {
              "atom_name": {
                "type": "string",
                "minLength": 1
              },
              "partner": {
                "$ref": "urn:simprep:schema:finding#/$defs/atom_ref"
              },
              "distance_angstrom": {
                "type": "number",
                "minimum": 0
              },
              "overlap_angstrom": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "relaxation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sites",
        "shell_residues",
        "mobile_atoms",
        "frozen",
        "left_out",
        "moved_residues",
        "moved_atoms",
        "max_displacement_angstrom",
        "rms_displacement_angstrom",
        "clashes_before",
        "clashes_after",
        "energy_kj_per_mol",
        "max_mobile_force_kj_per_mol_nm",
        "openmm_version"
      ],
      "properties": {
        "sites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:simprep:schema:finding#/$defs/residue_ref"
          }
        },
        "shell_residues": {
          "type": "integer",
          "minimum": 1
        },
        "mobile_atoms": {
          "type": "integer",
          "minimum": 0
        },
        "frozen": {
          "description": "Shell residues held fixed because a template-less residue lies within the non-bonded cutoff of their movable atoms.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chain",
              "seq_num",
              "ins_code",
              "near",
              "distance_angstrom"
            ],
            "properties": {
              "chain": {
                "type": "string"
              },
              "seq_num": {
                "type": "integer"
              },
              "ins_code": {
                "type": "string"
              },
              "near": {
                "type": "string"
              },
              "distance_angstrom": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "left_out": {
          "description": "Residues without a force-field template, left out of the calculation, with their closest distance to a mobile atom.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chain",
              "seq_num",
              "ins_code",
              "res_name",
              "distance_angstrom"
            ],
            "properties": {
              "chain": {
                "type": "string"
              },
              "seq_num": {
                "type": "integer"
              },
              "ins_code": {
                "type": "string"
              },
              "res_name": {
                "type": "string"
              },
              "distance_angstrom": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "moved_residues": {
          "type": "array",
          "items": {
            "$ref": "urn:simprep:schema:finding#/$defs/residue_ref"
          }
        },
        "moved_atoms": {
          "type": "integer",
          "minimum": 0
        },
        "max_displacement_angstrom": {
          "type": "number",
          "minimum": 0
        },
        "rms_displacement_angstrom": {
          "type": "number",
          "minimum": 0
        },
        "clashes_before": {
          "type": "integer",
          "minimum": 0
        },
        "clashes_after": {
          "type": "integer",
          "minimum": 0
        },
        "energy_kj_per_mol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "initial",
            "final",
            "note"
          ],
          "properties": {
            "initial": {
              "type": "number"
            },
            "final": {
              "type": "number"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "max_mobile_force_kj_per_mol_nm": {
          "type": "number",
          "minimum": 0
        },
        "openmm_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relaxed_wild_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "directory",
        "sites",
        "files",
        "counts",
        "relaxation",
        "findings",
        "work_order"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "sites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:simprep:schema:finding#/$defs/residue_ref"
          }
        },
        "files": {
          "$ref": "urn:simprep:schema:prep_record#/$defs/system/properties/files"
        },
        "counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:simprep:schema:prep_record#/$defs/count"
          }
        },
        "relaxation": {
          "$ref": "#/$defs/relaxation"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "urn:simprep:schema:finding"
          }
        },
        "work_order": {
          "type": "array",
          "items": {
            "$ref": "urn:simprep:schema:prep_record#/$defs/work_item"
          }
        }
      }
    }
  }
}
