{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simprep:schema:findings_report",
  "x-schema-version": "0.1.0",
  "title": "simprep audit output (findings.json)",
  "description": "Everything `simprep audit` emits: provenance, the audit configuration actually used, record accounting, and the findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "simprep", "knowledge_base", "input", "audit_config",
    "structure_summary", "counts", "findings"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "simprep": {"$ref": "urn:simprep:schema:manifest#/$defs/simprep"},
    "knowledge_base": {"$ref": "urn:simprep:schema:manifest#/$defs/knowledge_base"},
    "input": {"$ref": "urn:simprep:schema:manifest#/$defs/input"},
    "audit_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "regions", "severity_escalation"],
      "properties": {
        "manifest_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "urn:simprep:schema:manifest#/$defs/sha256"}]
        },
        "regions": {"type": "array", "items": {"$ref": "urn:simprep:schema:manifest#/$defs/region"}},
        "severity_escalation": {"$ref": "urn:simprep:schema:manifest#/$defs/severity_escalation"}
      }
    },
    "structure_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scope", "annotation_categories_present", "annotation_categories_absent"],
      "properties": {
        "name": {"type": "string"},
        "scope": {"type": "string", "minLength": 1},
        "annotation_categories_present": {"type": "array", "items": {"type": "string"}},
        "annotation_categories_absent": {"type": "array", "items": {"type": "string"}}
      }
    },
    "counts": {
      "description": "Every input record is either passed through unchanged, covered by a finding awaiting a decision, or excluded by a recorded decision: in = passed_through + flagged + excluded.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_type", "in", "passed_through", "flagged", "excluded"],
        "properties": {
          "record_type": {"type": "string", "minLength": 1},
          "in": {"type": "integer", "minimum": 0},
          "passed_through": {"type": "integer", "minimum": 0},
          "flagged": {"type": "integer", "minimum": 0},
          "excluded": {"type": "integer", "minimum": 0}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "urn:simprep:schema:finding"}}
  }
}
