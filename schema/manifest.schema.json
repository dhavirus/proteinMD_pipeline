{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simprep:schema:manifest",
  "x-schema-version": "0.1.0",
  "title": "simprep system manifest",
  "description": "Every decision about one simulation system, with rationale and provenance. v0.1 covers the audit stage; later stages add properties.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "created_at", "input", "knowledge_base", "simprep", "regions",
    "severity_escalation", "findings_snapshot", "decisions"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "input": {"$ref": "#/$defs/input"},
    "knowledge_base": {"$ref": "#/$defs/knowledge_base"},
    "simprep": {"$ref": "#/$defs/simprep"},
    "regions": {
      "type": "array",
      "items": {"$ref": "#/$defs/region"}
    },
    "severity_escalation": {"$ref": "#/$defs/severity_escalation"},
    "findings_snapshot": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generated_at", "findings_sha256", "findings"],
          "properties": {
            "generated_at": {"type": "string", "format": "date-time"},
            "findings_sha256": {"$ref": "#/$defs/sha256"},
            "findings": {"type": "array", "items": {"$ref": "urn:simprep:schema:finding"}}
          }
        }
      ]
    },
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "relaxation": {
      "description": "Relaxation protocol for variants and their matched wild type (TASK-006); simprep variants fills it from knowledge/relaxation.yaml when absent.",
      "$ref": "urn:simprep:schema:relaxation#/$defs/protocol"
    },
    "modelling": {
      "description": "Loop-modelling protocol for gaps decided `model_loop` (TASK-007); when absent, the defaults in knowledge/modelling.yaml are used and recorded in model_record.json.",
      "$ref": "urn:simprep:schema:modelling#/$defs/protocol"
    },
    "variants": {
      "description": "Variants to build from the prepared wild-type system (TASK-005). Optional.",
      "type": "array",
      "items": {"$ref": "#/$defs/variant"}
    },
    "variant_snapshot": {
      "description": "variant_build findings for `variants` (written by `simprep variants`); decided in `decisions` like any other finding. variants_sha256 is the RFC 8785 hash of the variants list the findings were computed for.",
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "variants_sha256", "findings_sha256", "findings"],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "variants_sha256": {"$ref": "#/$defs/sha256"},
        "findings_sha256": {"$ref": "#/$defs/sha256"},
        "findings": {"type": "array", "items": {"$ref": "urn:simprep:schema:finding"}}
      }
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mutations", "rationale", "references"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "mutations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mutation"}},
        "rationale": {"type": "string", "minLength": 1},
        "references": {"type": "array", "items": {"$ref": "urn:simprep:schema:finding#/$defs/reference"}}
      }
    },
    "mutation": {
      "description": "Replace the residue at chain/seq_num/ins_code (author numbering) whose name is `from` by `to` (chemical component ids).",
      "type": "object",
      "additionalProperties": false,
      "required": ["chain", "seq_num", "ins_code", "from", "to"],
      "properties": {
        "chain": {"type": "string", "minLength": 1},
        "seq_num": {"type": "integer"},
        "ins_code": {"type": "string", "maxLength": 1},
        "from": {"type": "string", "pattern": "^[A-Z0-9]{1,5}$"},
        "to": {"type": "string", "pattern": "^[A-Z0-9]{1,5}$"}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "format"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"enum": ["mmcif", "pdb"]}
      }
    },
    "knowledge_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "simprep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "git_commit"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "git_commit": {
          "description": "null when simprep does not run from a git checkout.",
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}(-dirty)?$"
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "residues"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "description": {"type": "string", "minLength": 1},
        "residues": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "urn:simprep:schema:finding#/$defs/residue_ref"}
        }
      }
    },
    "severity_escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thresholds"],
      "properties": {
        "thresholds": {
          "description": "A finding whose anchors lie within max_distance_angstrom (heavy atom to heavy atom) of a region is raised by raise_levels. The tightest matching threshold applies; a finding inside a region counts as distance 0.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_distance_angstrom", "raise_levels"],
            "properties": {
              "max_distance_angstrom": {"type": "number", "minimum": 0},
              "raise_levels": {"type": "integer", "minimum": 0, "maximum": 2}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "option_id", "rationale", "decided_by", "timestamp"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "option_id": {"type": "string", "minLength": 1},
        "parameters": {
          "description": "Option-specific choices, e.g. which altloc to keep.",
          "type": "object"
        },
        "rationale": {"type": "string", "minLength": 1},
        "decided_by": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    }
  }
}
