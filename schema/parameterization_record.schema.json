{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simprep:schema:parameterization_record",
  "x-schema-version": "0.1.0",
  "title": "simprep parameterization record (parameterization_record.json)",
  "description": "What the parameterization stage built (TASK-010): per protonated system the serialized OpenMM System, its particle count and net charge, how many residues got parameters from each source, the ion models applied (12-6-4), and the coverage checks (every bond and angle has parameters).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "simprep", "knowledge_base", "input", "manifest_sha256",
    "protonation_record_sha256", "protocol", "openmm_version", "systems", "work_order"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "simprep": {"$ref": "urn:simprep:schema:manifest#/$defs/simprep"},
    "knowledge_base": {"$ref": "urn:simprep:schema:manifest#/$defs/knowledge_base"},
    "input": {"$ref": "urn:simprep:schema:manifest#/$defs/input"},
    "manifest_sha256": {"$ref": "urn:simprep:schema:manifest#/$defs/sha256"},
    "protonation_record_sha256": {"$ref": "urn:simprep:schema:manifest#/$defs/sha256"},
    "protocol": {"$ref": "urn:simprep:schema:parameterization#/$defs/protocol"},
    "openmm_version": {"type": "string", "minLength": 1},
    "systems": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/system"}},
    "work_order": {"type": "array", "items": {"$ref": "urn:simprep:schema:prep_record#/$defs/work_item"}}
  },
  "$defs": {
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "directory", "source", "files", "particles", "net_charge", "residue_sources", "ion_models", "checks"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "directory": {"type": "string", "minLength": 1},
        "source": {"description": "Directory of the protonated system.", "type": "string", "minLength": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "format", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "format": {"enum": ["openmm_system_xml"]},
              "sha256": {"$ref": "urn:simprep:schema:manifest#/$defs/sha256"}
            }
          }
        },
        "particles": {"type": "integer", "minimum": 1},
        "net_charge": {"type": "number"},
        "residue_sources": {
          "description": "Number of residues per parameter source.",
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "ion_models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chain", "seq_num", "ins_code", "res_name", "finding_id", "model", "c4_pairs"],
            "properties": {
              "chain": {"type": "string"},
              "seq_num": {"type": "integer"},
              "ins_code": {"type": "string"},
              "res_name": {"type": "string"},
              "finding_id": {"type": "string"},
              "model": {"enum": ["lj1264"]},
              "c4_pairs": {"type": "integer", "minimum": 0}
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bonds", "bonds_expected", "angles", "angles_expected"],
          "properties": {
            "bonds": {"type": "integer", "minimum": 0},
            "bonds_expected": {"type": "integer", "minimum": 0},
            "angles": {"type": "integer", "minimum": 0},
            "angles_expected": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
